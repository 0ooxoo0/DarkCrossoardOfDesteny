{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "local": {
      "description": "Локальная Qwen3-8B через LM Studio: правки C# и Unity без облака",
      "mode": "primary",
      "model": "lmstudio/qwen3-8b",
      "permissions": [
        { "action": "windows_*", "resource": "*", "effect": "deny" },
        { "action": "gsd_*", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "unityMCP": {
        "type": "local",
        "command": [
          "C:\\Users\\Overlord\\AppData\\Roaming\\Python\\Python314\\Scripts\\uvx.exe",
          "--python",
          "3.12",
          "--from",
          "mcpforunityserver",
          "mcp-for-unity",
          "--transport",
          "stdio"
        ]
      }
    }
  },
  "watcher": {
    "ignore": [
      "Library/**",
      "Temp/**",
      "Logs/**",
      "Obj/**",
      "Build/**",
      "Builds/**",
      "UserSettings/**",
      "*.csproj",
      "*.sln"
    ]
  }
}
