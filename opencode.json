{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "local": {
      "description": "Локальная Qwen2.5-7B через Ollama: правки C# и Unity без облака",
      "mode": "primary",
      "model": "ollama/qwen2.5:7b-instruct",
      "permissions": [
        { "action": "windows_*", "resource": "*", "effect": "deny" },
        { "action": "gsd_*", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "websearch": false,
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "agent-desktop_*", "resource": "*", "effect": "deny" },
    { "action": "agent-desktop_desktop_snapshot", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_screenshot", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_list_apps", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_list_windows", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_focus_window", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_launch", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_click", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_type", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_press", "resource": "*", "effect": "allow" },
    { "action": "agent-desktop_desktop_scroll", "resource": "*", "effect": "allow" }
  ],
  "providers": {
    "ollama": {
      "models": {
        "qwen2.5:7b-instruct": {
          "name": "Qwen2.5 7B (local, tools)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "qwen2.5:14b": {
          "name": "Qwen2.5 14B (local, tools, slow)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "unityMCP": {
        "type": "local",
        "command": [
          "C:\\Users\\Overlord\\AppData\\Roaming\\Python\\Python314\\Scripts\\uvx.exe",
          "--python",
          "3.12",
          "--from",
          "mcpforunityserver",
          "mcp-for-unity",
          "--transport",
          "stdio"
        ]
      },
      "agent-desktop": {
        "type": "local",
        "command": [
          "C:\\Users\\Overlord\\AppData\\Roaming\\npm\\agent-desktop.cmd",
          "mcp"
        ],
        "codemode": false
      },
      "web-search": {
        "type": "local",
        "command": [
          "C:\\Users\\Overlord\\AppData\\Roaming\\Python\\Python314\\Scripts\\uvx.exe",
          "duckduckgo-mcp-server"
        ],
        "codemode": false
      }
    }
  },
  "watcher": {
    "ignore": [
      "Library/**",
      "Temp/**",
      "Logs/**",
      "Obj/**",
      "Build/**",
      "Builds/**",
      "UserSettings/**",
      "*.csproj",
      "*.sln"
    ]
  }
}
